build/

# Paket rilis V1 ikut di-track supaya bisa diunduh langsung dari GitHub.
# pindex.exe tetap diabaikan: 9,8 MB artefak build, dibangun sendiri
# dengan `go build -o dist/v1/pindex.exe ./src/pro`.
!dist/
!dist/*.txt
!dist/v1/
!dist/v1/*.html
!dist/v1/*.js
!dist/v1/*.css
!dist/v1/*.txt
!dist/v1/data.example.json
!dist/v1/favicon.png
!dist/v1/assets/

